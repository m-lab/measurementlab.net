---
import { getCollection } from 'astro:content';
import Tag from '@components/atoms/Tag';
import Card from '@components/molecules/Card.astro';
import datasetCategories from '@content/categories/datasets.json';
import SectionLayout from '@layouts/SectionLayout.astro';
import { isVisible } from '@utils/content';

const datasets = (await getCollection('datasets')).filter((ds) => isVisible(ds));

/** Where entries with no `category` land. Must exist in datasets.json. */
const FALLBACK_CATEGORY = 'uncategorized';

// Lowest `order` first; empty groups are dropped rather than rendered as headings
// with nothing under them.
const groups = [...datasetCategories.categories]
	.sort((a, b) => a.order - b.order)
	.map((category) => ({
		...category,
		datasets: datasets
			.filter((ds) => (ds.data.category ?? FALLBACK_CATEGORY) === category.id)
			.sort((a, b) => a.data.title.localeCompare(b.data.title)),
	}));

// A dataset that matches no group would vanish from the page with no other symptom.
// The Zod enum makes that impossible for an explicit category, but it becomes
// reachable the moment someone removes the fallback entry from datasets.json.
const grouped = new Set(groups.flatMap((g) => g.datasets.map((ds) => ds.id)));
const orphans = datasets.filter((ds) => !grouped.has(ds.id));
if (orphans.length > 0) {
	throw new Error(
		`DatasetsLanding: ${orphans.length} dataset(s) match no category group: ` +
			`${orphans.map((ds) => ds.id).join(', ')}. ` +
			`Add the missing category to src/content/categories/datasets.json ` +
			`(entries with no category need one with id "${FALLBACK_CATEGORY}").`
	);
}

const activeGroups = groups.filter((group) => group.datasets.length > 0);

const formatFrequency = (f: string) => f.charAt(0).toUpperCase() + f.slice(1);
---

<div class="pb-12">
	{
		activeGroups.map((group) => (
			<SectionLayout maxWidth="4xl" sectionLabel={`section > ${group.name}`}>
				<div class="mb-8">
					<h2 class="mb-2 text-2xl font-bold">{group.name}</h2>
					{group.description && (
						<p class="text-muted max-w-2xl">{group.description}</p>
					)}
				</div>

				<div class="grid gap-5">
					{group.datasets.map((ds) => (
						<Card
							variant="elevated"
							padding="lg"
							class="w-full"
							href={`/datasets/${ds.id}`}
						>
							<div class="mb-3 flex flex-wrap gap-2">
								{ds.data.updateFrequency && (
									<Tag variant="primary" size="sm">
										{formatFrequency(ds.data.updateFrequency)}
									</Tag>
								)}
								{ds.data.spatialCoverage && (
									<Tag variant="secondary" size="sm">
										{ds.data.spatialCoverage}
									</Tag>
								)}
							</div>
							<h3 class="mb-2 text-xl leading-snug font-semibold">
								{ds.data.title}
							</h3>
							<p class="text-muted mb-4 text-base">{ds.data.description}</p>
							{ds.data.temporalCoverageStart && (
								<p class="text-faint border-neutral-100 mt-auto border-t pt-3 text-sm">
									{ds.data.temporalCoverageStart.slice(0, 4)}
									{ds.data.temporalCoverageEnd
										? ` – ${ds.data.temporalCoverageEnd === 'present' ? 'present' : ds.data.temporalCoverageEnd.slice(0, 4)}`
										: ''}
								</p>
							)}
						</Card>
					))}
				</div>
			</SectionLayout>
		))
	}
</div>
