---
import FilterableContent from '@components/organisms/Filter/FilterableContent';
import { getBlogPosts, prepareBlogPostsCardData } from '@utils/blog';

// Fetch all blog posts using utilities
const posts = await getBlogPosts();
const postsData = await prepareBlogPostsCardData(posts);
---

<div class="pb-12">
	<FilterableContent
		client:load
		type="blog"
		items={postsData}
		fields={["categories", "tags"]}
	/>
</div>
