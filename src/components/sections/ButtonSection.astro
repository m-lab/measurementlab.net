---
import Button from '@components/atoms/Button.tsx';
import Heading from '@components/atoms/Heading.astro';
import type { ButtonType } from '@content-config';

export interface Props {
  title?: string;
  buttons?: ButtonType[];
  class?: string;
}

// `class` is accepted for compatibility but applied by the SectionLayout wrapper in
// Sections.astro, not here.
const { title, buttons = [] } = Astro.props;
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
	<!-- Section Header -->
	{
		title && (
			<div class="mb-12 text-center">
				{title && <Heading level={2} class="mb-4">{title}</Heading>}
			</div>
		)
	}

	<!-- Buttons -->
	{
		buttons.length > 0 && (
			<div class="flex flex-wrap justify-center gap-4">
				{buttons.map((button) => (
					<Button
						type="button"
						as="a"
						variant={button.variant}
						size={button.size}
						icon={button.icon}
						href={button.href}
					>
						{button.text}
					</Button>
				))}
			</div>
		)
	}
</div>
