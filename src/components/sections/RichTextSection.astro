---

import renderMarkdownWithImages from '@utils/renderMarkdown';

export interface Props {
  content: string;
  background?: string;
  withTOC?: boolean;
}

const { content, withTOC = true } = Astro.props;

const html = await renderMarkdownWithImages(content, withTOC);


---

<div class="mx-auto prose max-w-3xl">
	<Fragment set:html={html} />
</div>
