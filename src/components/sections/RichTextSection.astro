---

import TOC from '@components/organisms/TOC.tsx';
import type { TocEntry } from '@stefanprobst/rehype-extract-toc';
import renderMarkdownWithImages from '@utils/renderMarkdown';

export interface Props {
  id: string;
  content: string;
  background?: string;
  withTOC?: boolean;
}

const { id, content, withTOC = false } = Astro.props;

const { html, toc } = (await renderMarkdownWithImages(content, withTOC, id));

// Count total entries including nested children
const countTocEntries = (entries: TocEntry[]): number => {
	return entries.reduce((count, entry) => {
		return count + 1 + (entry.children ? countTocEntries(entry.children) : 0);
	}, 0);
};

// const totalEntries = toc && Array.isArray(toc) ? countTocEntries(toc) : 0;


---

<div id={id} class="relative mx-auto max-w-7xl">
	<div class={`${withTOC ? 'md:flex md:justify-center md:gap-8' : ''}`}>
		{
			withTOC && toc && (
				<div class="hidden md:block md:w-[200px] md:shrink-0">
					<TOC entries={toc} id={`toc-${id}`} client:load />
				</div>
			)
		}

		<div class={`prose max-w-3xl ${withTOC ? '' : 'mx-auto'}`}>
			<Fragment set:html={html} />
		</div>
	</div>
</div>
