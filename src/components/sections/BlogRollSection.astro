---
import Button from '@components/atoms/Button.tsx';
import BlogItem from '@components/organisms/Blog/BlogItem.tsx';
import { getBlogPosts, prepareBlogPostsCardData } from '@utils/blog';
import { isDev } from '@utils/dev';

export interface Props {
  title?: string;
  description?: string;
  limit?: number;
  showMore?: boolean;
}

const {
  title = 'Latest News',
  description,
  limit = 3,
  showMore = false,
} = Astro.props;

// Fetch posts using utilities (automatically filters drafts based on environment)
const posts = await getBlogPosts({ limit });
const postsData = await prepareBlogPostsCardData(posts);

---

<div class="py-12">
	<!-- Section Header -->
	<div class="mb-8">
		<h2 class="text-3xl font-bold text-neutral-900">{title}</h2>
		{description && <p class="text-gray-600 mt-2">{description}</p>}
	</div>

	<!-- Posts Grid -->
	{
		postsData.length === 0 ? (
			<div class="py-12 text-center">
				<p class="text-gray-600 text-lg">
					No blog posts published yet. Check back soon!
				</p>
			</div>
		) : (
			<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
				{postsData.map((item) => (
          <BlogItem item={item} />
        ))}
			</div>
		)
	}

	<!-- Optional "Show More" Button -->
	{
		showMore && postsData.length > 0 && (
			<div class="mt-8 text-center">
				<Button
					as="a"
					href="/blog"
					variant="primary"
					icon="arrowRight"
					size="md"
				>
					Show More
				</Button>
			</div>
		)
	}
</div>
