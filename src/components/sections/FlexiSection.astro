---
import Heading from '@components/atoms/Heading.astro';
import Sections from '@components/sections/Sections.astro';
import SectionLayout from '@layouts/SectionLayout.astro';

export interface SectionType {
  type: string;
  [key: string]: any;
}

export interface Props {
  title: string;
  description?: string;
  sections?: SectionType[];
  /** Surface this flexi is drawn on — passed down so nested sections invert with it. */
  background?: { color?: string };
}

const { title, description, sections = [], background } = Astro.props;

// This wrapper paints nothing itself; the enclosing SectionLayout already painted the
// background. It only needs the colour so its own heading and its nested children take
// their contrast from the surface they sit on.
const inheritedBackground = background?.color;
---

<SectionLayout inheritedBgColor={inheritedBackground}>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<!-- Section Header -->
		<div class="mb-12 text-center">
			<Heading level={2} class="mb-4">{title}</Heading>
			{description && <p class="text-gray-600">{description}</p>}
		</div>

		<!-- Sections -->
		<Sections sectionItems={sections} inheritedBackground={inheritedBackground} />
	</div>
</SectionLayout>
