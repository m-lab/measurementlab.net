---
import Heading from '@components/atoms/Heading.astro';
import Text from '@components/atoms/Text.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Infrastructure Map', description } = Astro.props;
---

<div class="infrastructure-map-section">
	{
		title && (
			<Heading level={2} class="mb-6 text-2xl font-bold">
				{title}
			</Heading>
		)
	}
	{
		description && (
			<Text class="text-gray-600 mb-6 max-w-3xl text-lg">{description}</Text>
		)
	}
	<div
		id="infrastructure-map-container"
		class="h-125 w-full overflow-hidden rounded-lg"
	>
	</div>
</div>

<style>
	/* Mapbox popup styles */
	:global(#infrastructure-map-container .mapboxgl-popup-content) {
		background: #1a1a2e;
		color: #fff;
		border-radius: 8px;
		padding: 0;
		max-height: 300px;
		overflow-y: auto;
	}

	:global(.mapboxgl-popup-close-button) {
		color: #fff;
		font-size: 18px;
		padding: 4px 8px;
	}

	:global(.mapboxgl-popup-close-button:hover) {
		background: rgba(255, 255, 255, 0.1);
	}

	:global(.cluster-popup .mapboxgl-popup-content),
	:global(.point-popup .mapboxgl-popup-content) {
		min-width: 200px;
	}

	:global(.pod-popup) {
		padding: 12px 16px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	:global(.pod-popup:last-child) {
		border-bottom: none;
	}

	:global(.pod-popup h4) {
		margin: 0 0 8px 0;
		font-size: 14px;
		font-weight: 600;
		color: #deebf7;
	}

	:global(.pod-popup) {
		font-size: 12px;
		line-height: 1.5;
		color: #ccc;
	}
</style>

<script is:inline>
	var MAPBOX_SRC = 'https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl';
	var mapboxSdkPromise = null;

	// The SDK is ~800KB parsed and this map sits below the fold on every page that
	// uses it, so the stylesheet and script are injected on demand
	function loadMapboxSdk() {
		if (mapboxSdkPromise) return mapboxSdkPromise;

		mapboxSdkPromise = new Promise(function (resolve, reject) {
			if (typeof mapboxgl !== 'undefined') {
				resolve();
				return;
			}

			var link = document.createElement('link');
			link.rel = 'stylesheet';
			link.href = MAPBOX_SRC + '.css';
			document.head.appendChild(link);

			var script = document.createElement('script');
			script.src = MAPBOX_SRC + '.js';
			script.async = true;
			script.onload = resolve;
			script.onerror = reject;
			document.head.appendChild(script);
		});

		return mapboxSdkPromise;
	}

	function initInfrastructureMap() {
		var container = document.getElementById('infrastructure-map-container');
		if (!container) return;

		// Check if map is already initialized
		if (container.dataset.mapInitialized === 'true') return;
		container.dataset.mapInitialized = 'true';

		loadMapboxSdk().then(function () {
			buildInfrastructureMap(container);
		});
	}

	function buildInfrastructureMap(container) {
		mapboxgl.accessToken =
			'pk.eyJ1IjoibS1sYWIiLCJhIjoiY2xsdmN2NXBuMTl1ZDNmcGh1ZmxmaGwzcSJ9.3xXvAS4T6tZoahEeevGa4A';

		var map = new mapboxgl.Map({
			container: 'infrastructure-map-container',
			style: 'mapbox://styles/mapbox/dark-v10',
			center: [5, 17],
			zoom: 1.2,
		});

		// Handle for the astro:before-swap teardown below.
		container._mlabMap = map;

		var url =
			'https://locate.measurementlab.net/v2/siteinfo/registrations?format=geo&exp=ndt';

		map.on('load', function () {
			var tenG = ['==', ['get', 'uplink'], '10g'];
			var oneG = ['==', ['get', 'uplink'], '1g'];

			map.addSource('mlab-sites', {
				type: 'geojson',
				data: url,
				cluster: true,
				clusterRadius: 1,
				clusterProperties: {
					oneG: ['+', ['case', oneG, 1, 0]],
					tenG: ['+', ['case', tenG, 1, 0]],
				},
			});

			map.addLayer({
				id: 'clusters',
				type: 'circle',
				source: 'mlab-sites',
				filter: ['has', 'point_count'],
				paint: {
					'circle-radius': ['step', ['get', 'point_count'], 7, 3, 11, 6, 15],
					'circle-color': [
						'step',
						['get', 'point_count'],
						'#deebf7',
						3,
						'#9ecae1',
						6,
						'#3182bd',
					],
				},
			});

			map.addLayer({
				id: 'cluster-count',
				type: 'symbol',
				source: 'mlab-sites',
				filter: ['has', 'point_count'],
				layout: {
					'text-field': '{point_count_abbreviated}',
					'text-font': ['DIN Offc Pro Medium', 'Arial Unicode MS Bold'],
					'text-size': 12,
				},
			});

			map.addLayer({
				id: 'unclustered-point',
				type: 'circle',
				source: 'mlab-sites',
				filter: ['!', ['has', 'point_count']],
				paint: {
					'circle-radius': 7,
					'circle-color': '#deebf7',
					'circle-stroke-width': 0,
				},
			});

			map.addLayer({
				id: 'unclustered-count',
				type: 'symbol',
				source: 'mlab-sites',
				filter: ['!', ['has', 'point_count']],
				layout: {
					'text-field': '1',
					'text-font': ['DIN Offc Pro Medium', 'Arial Unicode MS Bold'],
					'text-size': 12,
				},
			});

			var clusterPopup = new mapboxgl.Popup({
				className: 'cluster-popup',
			});

			var pointPopup = new mapboxgl.Popup({
				className: 'point-popup',
			});

			map.on('click', 'clusters', function (e) {
				var features = map.queryRenderedFeatures(e.point, {
					layers: ['clusters'],
				});
				var clusterId = features[0].properties.cluster_id;
				var pointCount = features[0].properties.point_count;
				var clusterSource = map.getSource('mlab-sites');

				clusterSource.getClusterLeaves(
					clusterId,
					pointCount,
					0,
					function (err, aFeatures) {
						if (err || !aFeatures) return;

						var desc = '';
						for (var c = 0; c < aFeatures.length; c++) {
							var props = aFeatures[c].properties;
							desc +=
								"<div class='pod-popup'><h4>" +
								props.machine +
								'</h4>' +
								'Org: ' +
								props.org +
								'<br>' +
								'Type: ' +
								props.type +
								'<br>' +
								'Uplink: ' +
								props.uplink +
								'</div>';
						}

						var coordinates = e.lngLat;
						clusterPopup.setLngLat(coordinates).setHTML(desc).addTo(map);
					}
				);
			});

			map.on('click', 'unclustered-point', function (e) {
				if (!e.features || e.features.length === 0) return;

				var feature = e.features[0];
				var coordinates = feature.geometry.coordinates.slice();
				var props = feature.properties;

				var description =
					"<div class='pod-popup'><h4>" +
					props.machine +
					'</h4>' +
					'Org: ' +
					props.org +
					'<br>' +
					'Type: ' +
					props.type +
					'<br>' +
					'Uplink: ' +
					props.uplink +
					'</div>';

				// Handle world wrapping
				while (Math.abs(e.lngLat.lng - coordinates[0]) > 180) {
					coordinates[0] += e.lngLat.lng > coordinates[0] ? 360 : -360;
				}

				pointPopup.setLngLat(coordinates).setHTML(description).addTo(map);
			});

			// Cursor changes on hover
			map.on('mouseenter', 'clusters', function () {
				map.getCanvas().style.cursor = 'pointer';
			});

			map.on('mouseleave', 'clusters', function () {
				map.getCanvas().style.cursor = '';
			});

			map.on('mouseenter', 'unclustered-point', function () {
				map.getCanvas().style.cursor = 'pointer';
			});

			map.on('mouseleave', 'unclustered-point', function () {
				map.getCanvas().style.cursor = '';
			});
		});
	}

	// Only pull in the SDK once the container gets close to the viewport. The
	// margin gives the download a head start so the map is usually ready by the
	// time it is actually scrolled to.
	function observeInfrastructureMap() {
		var container = document.getElementById('infrastructure-map-container');
		if (!container || container.dataset.mapInitialized === 'true') return;

		if (!('IntersectionObserver' in window)) {
			initInfrastructureMap();
			return;
		}

		var observer = new IntersectionObserver(
			function (entries) {
				for (var i = 0; i < entries.length; i++) {
					if (!entries[i].isIntersecting) continue;
					observer.disconnect();
					initInfrastructureMap();
					return;
				}
			},
			{ rootMargin: '400px' }
		);

		observer.observe(container);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', observeInfrastructureMap);
	} else {
		observeInfrastructureMap();
	}

	// Bound once: this script re-runs on every ClientRouter swap, and stacking
	// duplicate listeners was leaking a map per navigation.
	if (!window.__mlabMapListenersBound) {
		window.__mlabMapListenersBound = true;

		// Re-arm on Astro page transitions.
		document.addEventListener('astro:page-load', observeInfrastructureMap);

		// ClientRouter swaps in a fresh container, so the outgoing mapboxgl.Map
		// has to release its WebGL context and tile caches explicitly.
		document.addEventListener('astro:before-swap', function () {
			var container = document.getElementById('infrastructure-map-container');
			if (container && container._mlabMap) {
				container._mlabMap.remove();
				container._mlabMap = null;
			}
		});
	}
</script>
