---
import Button from '@components/atoms/Button.tsx';
import Heading from '@components/atoms/Heading.astro';
import HouseCard from '@components/molecules/HouseCard.astro';
import type { ButtonType, CardType } from '@content-config';
import SectionLayout from '@layouts/SectionLayout.astro';

export interface Props {
  title: string;
  description?: string;
  cards?: CardType[];
  buttons?: ButtonType[];
  class?: string;
}

// `class` is accepted for compatibility but applied by the SectionLayout wrapper in
// Sections.astro, not here.
const { title, description, cards = [], buttons = [] } = Astro.props;
---

<SectionLayout>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<!-- Section Header -->
		<div class="mb-12 text-center">
			<Heading level={2} class="mb-4">{title}</Heading>
			{description && <p class="text-gray-600">{description}</p>}
		</div>

		<!-- Cards Grid -->
		{
			cards.length > 0 && (
				<div class="mb-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
					{cards.map((card) => (
						<HouseCard
							image={card.image}
							title={card.title}
							description={card.content}
							cardType="container"
							variant={card.color}
							icon={card.icon}
						>
							{card.button && (
								<Button
									type="button"
									as="a"
									variant={card.button.variant}
									size={card.button.size}
									icon={card.button.icon}
									href={card.button.href}
								>
									{card.button.text}
								</Button>
							)}
						</HouseCard>
					))}
				</div>
			)
		}

		<!-- Action Buttons -->
		{
			buttons.length > 0 && (
				<div class="flex flex-wrap justify-center gap-4">
					{buttons.map((button) => (
						<Button
							type="button"
							as="a"
							variant={button.variant}
							size={button.size}
							icon={button.icon}
							href={button.href}
						>
							{button.text}
						</Button>
					))}
				</div>
			)
		}
	</div>
</SectionLayout>
