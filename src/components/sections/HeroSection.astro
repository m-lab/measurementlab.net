---
import Hero from '@components/organisms/Hero.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  subtitle?: string;
	class?: string;
	background?: {
		color: 'white' | 'gray' | 'primary-light' | 'primary-medium' | 'primary-dark';
		image?: ImageMetadata;
	};
}

// `background` is accepted but rendered by the SectionLayout wrapper in Sections.astro.
const { title, subtitle, class: className = '' } = Astro.props;
---

<Hero title={title} subtitle={subtitle} size="default" class={className}>
	<slot />
</Hero>
