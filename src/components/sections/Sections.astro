---
import BlogRollSection from '@components/sections/BlogRollSection.astro';
import ButtonSection from '@components/sections/ButtonSection.astro';
import CardSection from '@components/sections/CardSection.astro';
import FeaturedPartnersSection from '@components/sections/FeaturedPartnersSection.astro';
import FlexiSection from '@components/sections/FlexiSection.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import InfrastructureMapSection from '@components/sections/InfrastructureMapSection.astro';
import PartnersSection from '@components/sections/PartnersSection.astro';
import PeopleSection from '@components/sections/PeopleSection.astro';
import RelatedPostsSection from '@components/sections/RelatedPostsSection.astro';
import RichTextSection from '@components/sections/RichTextSection.astro';
import SpeedTestSection from '@components/sections/SpeedTestSection.astro';
import TestsSection from '@components/sections/TestsSection.astro';
import SectionLayout from '@layouts/SectionLayout.astro';

// `inheritedBackground` is the background colour of an enclosing section (set by
// FlexiSection for its nested children). A nested section with no background of its own
// is drawn on that surface, so it must take its contrast from it.
const { sectionItems, inheritedBackground } = Astro.props;

let richTextCounter = 0;
---

{
	sectionItems.map((section: any) => {
		const sectionLabel = `section > ${section.type}`;
		// The surface this section's content actually sits on.
		const effectiveBackground = section.background?.color ?? inheritedBackground;
		// const richTextId = section.type === 'richText' ? `text-section-${++richTextCounter}` : undefined;

		const content = (() => {
			switch (section.type) {
				case 'button':
					return (
						<ButtonSection title={section.title} buttons={section.buttons} />
					);
				case 'flexi':
					return (
						<FlexiSection
							title={section.title}
							description={section.description}
							sections={section.sections}
							background={{ color: effectiveBackground }}
						/>
					);
				case 'hero':
					return (
						<HeroSection
							title={section.title}
							subtitle={section.subtitle}
							background={section.background}
						/>
					);
				case 'richText':
					const richTextId = `text-section-${++richTextCounter}`;
					return (
						<RichTextSection
							id={richTextId}
							background={{ color: effectiveBackground }}
							content={section.content}
							withTOC={section.withTOC}
						/>
					);
				case 'card':
					return (
						<CardSection
							title={section.title}
							description={section.description}
							cards={section.cards}
							buttons={section.buttons}
						/>
					);
				case 'people':
					return <PeopleSection category={section.category} />;
				case 'partners':
					return (
						<PartnersSection
							title={section.title}
							category={section.category}
						/>
					);
				case 'speed_test':
					return (
						<SpeedTestSection
							title={section.title}
							description={section.description}
						/>
					);
				case 'featured_partners':
					return (
						<FeaturedPartnersSection
							title={section.title}
							description={section.description}
						/>
					);
				case 'blog_roll':
					return (
						<BlogRollSection
							title={section.title}
							description={section.description}
							limit={section.limit}
							showMore={section.showMore}
						/>
					);
				case 'related_posts':
					return (
						<RelatedPostsSection
							title={section.title}
							description={section.description}
							posts={section.posts}
						/>
					);
				case 'tests':
					return (
						<TestsSection
							title={section.title}
							description={section.description}
							tests={section.tests}
						/>
					);
				case 'infrastructureMap':
					return <InfrastructureMapSection title={section.title} description={section.description} />;
				default:
					return null;
			}
		})();

		if (section.type == 'hero') {
			return (
				<SectionLayout
					bgImage={section.background}
					class={section.class}
					sectionLabel={sectionLabel}
					maxWidth="2xl"
					zigzag={section.zigzag}
				>
					{content}
				</SectionLayout>
			);
		}

		return (
			<SectionLayout
				bgImage={section.background?.image}
				class={section.class}
				sectionLabel={sectionLabel}
				bgColor={section.background?.color}
				inheritedBgColor={inheritedBackground}
			>
				{content}
			</SectionLayout>
		);
	})
}
