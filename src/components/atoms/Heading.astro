---
import { slugify } from '@utils/slugify';

export interface Props {
  level: 1 | 2 | 3 | 4 | 5 | 6;
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  anchor?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  level,
  as,
  anchor,
  class: className = '',
  ...props
} = Astro.props;

const Tag = (as || `h${level}`) as keyof typeof styles;

const styles = {
  h1: 'text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight',
  h2: 'text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight',
  h3: 'text-2xl md:text-3xl lg:text-4xl font-semibold',
  h4: 'text-xl md:text-2xl lg:text-3xl font-semibold',
  h5: 'text-lg md:text-xl lg:text-2xl font-medium',
  h6: 'text-base md:text-lg lg:text-xl font-medium',
};

// Default: anchor is true for h1/h2, false otherwise
const showAnchor = anchor ?? (level <= 2);

const slotContent = await Astro.slots.render('default');
const textContent = slotContent.replace(/<[^>]*>/g, '').trim();
const slug = showAnchor ? slugify(textContent) : undefined;

const classes = `${showAnchor ? 'heading-anchor-group ' : ''}${styles[Tag]} ${className}`.trim();
---

<Tag class={classes} id={slug} {...props}>
  <slot />
  {showAnchor && slug && (
    <a class="heading-anchor" aria-hidden="true" tabindex="-1" href={`#${slug}`}>
      <span class="heading-anchor-icon">#</span>
    </a>
  )}
</Tag>
