---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  variant?: 'default' | 'bordered' | 'elevated';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  href?: string;
  external?: boolean;
  class?: string;
}

const {
  variant = 'default',
  padding = 'md',
  href,
  external = false,
  class: className = '',
  ...props
} = Astro.props;

const variants = {
  default: 'card-default',
  bordered: 'card-bordered',
  elevated: 'card-elevated',
};

const paddings = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const linkClasses = href ? 'block no-underline hover:no-underline text-inherit font-normal hover:shadow-lg transition' : '';
const classes = `rounded-md ${variants[variant]} ${paddings[padding]} ${linkClasses} ${className}`.trim();

const externalProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
	href ? (
		<a href={href} class={classes} {...externalProps} {...props}>
			<slot />
		</a>
	) : (
		<div class={classes} {...props}>
			<slot />
		</div>
	)
}
