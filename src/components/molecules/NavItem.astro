---
import Link from '@components/atoms/Link';
import NavItemDropdown from '@components/molecules/NavItemDropdown';
import type { NavItem as TNavItem } from '@utils/navigation';

export type Props = {
  item: TNavItem;
  active?: boolean;
  class?: string;
}

const {
  item,
  active = false,
  class: className = '',
} = Astro.props;

const { href, label, type, children } = item;

const activeStyles = active
  ? 'underline decoration-2'
  : ' hover:decoration-gray-100';

const classes = `no-underline hover:underline transition transition-300 underline-offset-20 inline-flex items-center px-3 py-2  ${activeStyles} ${className}`;
---

{children ? (
	<NavItemDropdown label={label} items={children} class={className} client:idle />
) : (
	<Link href={href} variant="nav" className={classes} external={type === 'external'}>
		{label}
	</Link>
)}
