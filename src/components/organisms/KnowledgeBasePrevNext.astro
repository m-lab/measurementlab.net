---
import type { KbEntry } from '@utils/kb';

export interface Props {
  prev: KbEntry | null;
  next: KbEntry | null;
}

const { prev, next } = Astro.props;

// Doc titles run long, so these are cards rather than buttons — a button sized
// to its label would set two wildly different widths at the foot of the page.
// Raw anchors, as in Card.astro: the Link atom wraps all children in one span
// and forces `flex items-center`, which collapses a two-line card.
const cardClass =
  'group flex h-full flex-col gap-1 rounded-lg border border-neutral-200 p-4 no-underline transition-colors hover:border-primary-300 hover:bg-primary-50';
const labelClass =
  'text-xs font-semibold tracking-wide text-neutral-500 uppercase';
const titleClass =
  'font-medium text-neutral-900 group-hover:text-primary-700';
---

{
  (prev || next) && (
    <nav
      class="mt-12 grid gap-4 border-t border-neutral-200 pt-8 sm:grid-cols-2"
      aria-label="Documentation pages"
    >
      {prev ? (
        <a href={`/kb/${prev.data.permalink}`} class={cardClass} rel="prev">
          <span class={labelClass}>&larr; Previous</span>
          <span class={titleClass}>{prev.data.title}</span>
        </a>
      ) : (
        <div class="hidden sm:block" />
      )}

      {next && (
        <a
          href={`/kb/${next.data.permalink}`}
          class={`${cardClass} sm:items-end sm:text-right`}
          rel="next"
        >
          <span class={labelClass}>Next &rarr;</span>
          <span class={titleClass}>{next.data.title}</span>
        </a>
      )}
    </nav>
  )
}
