---
/**
 * /datasets/[slug] — Individual dataset page
 *
 * Follows the same shape as the other detail pages (publications, tests):
 *   breadcrumbs → hero with metadata tags → single 4xl column
 *
 * Head embeds:
 *   - schema.org/Dataset JSON-LD
 *   - Dublin Core <meta> tags
 *
 * M-Lab constants (creator, publisher, license, language, type, subject)
 * are pre-populated here — intentionally not stored in content files.
 */
import { getCollection } from 'astro:content';
import JsonLd from '@components/atoms/JsonLd.astro';
import Link from '@components/atoms/Link';
import Tag from '@components/atoms/Tag';
import Card from '@components/molecules/Card.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import datasetCategories from '@content/categories/datasets.json';
import PageLayout from '@layouts/PageLayout.astro';
import SectionLayout from '@layouts/SectionLayout.astro';
import { isVisible } from '@utils/content';
import {
  buildDatasetNode,
  datasetUrl,
  keywordsFor,
  LICENSE_URL,
  MLAB_CREATOR,
  temporalCoverageOf,
} from '@utils/datasetSchema';
import ArrowTopRightOnSquareIcon from '~icons/heroicons/arrow-top-right-on-square-20-solid';
import ChevronRightIcon from '~icons/heroicons/chevron-right-20-solid';
import DocumentTextIcon from '~icons/heroicons/document-text-20-solid';

export async function getStaticPaths() {
  const datasets = await getCollection('datasets');
  return datasets
    .filter((ds) => isVisible(ds))
    .map((ds) => ({ params: { slug: ds.id }, props: { ds } }));
}

const { ds } = Astro.props;
const {
  title,
  description,
  category,
  temporalCoverageStart,
  temporalCoverageEnd,
  spatialCoverage,
  updateFrequency,
  accessPoints,
  dataSize,
  documentationLinks,
  testRef,
  relatedDatasets,
} = ds.data;

const canonicalUrl = datasetUrl(ds.id);

const temporalCoverage = temporalCoverageOf(ds.data);

// Same merged list the JSON-LD uses, so DC.subject and schema.org keywords are aligned
const keywords = keywordsFor(ds.data);

// categories are abstracted into a category collection so they can be managed through the CMS
const categoryName =
  datasetCategories.categories.find(
    (c) => c.id === (category ?? 'uncategorized')
  )?.name ?? 'Dataset';

const coverageLabel = temporalCoverageStart
  ? `${temporalCoverageStart.slice(0, 4)}${temporalCoverageEnd ? ` – ${temporalCoverageEnd === 'present' ? 'present' : temporalCoverageEnd.slice(0, 4)}` : ''}`
  : null;

// Identical to the node embedded in the catalog's `dataset` array — same builder, same
// `@id` — so the two descriptions merge rather than compete.
const datasetJsonLd = buildDatasetNode(ds, { standalone: true });

const allDatasets = await getCollection('datasets');
const related = (relatedDatasets ?? [])
  .map((id) => allDatasets.find((d) => d.id === id))
  .filter(Boolean);

const accessUrl = (url: string) =>
  url.startsWith('gs://')
    ? `https://console.cloud.google.com/storage/browser/${url.replace('gs://', '')}`
    : url;

// Colour access points by how you reach the data, not by file format. `type` is a
// schema enum and is always set; `format` is free text, so the previous format-keyed
// lookup silently fell through for values like "JSON / raw TCP trace".
const accessVariants = {
  query: 'primary',
  download: 'supporting1',
  api: 'speed',
  viz: 'secondary',
} as const;

const accessVariant = (type?: keyof typeof accessVariants) =>
  (type && accessVariants[type]) || 'neutral';

const isExternal = (url: string) => url.startsWith('http') || url.startsWith('gs://');

const formatFrequency = (f: string) => f.charAt(0).toUpperCase() + f.slice(1);

// Rendered as a definition list; entries with no value drop out. Category and coverage
// are deliberately absent — they are the hero tags, and repeating them here would say
// the same thing twice on one screen.
const metadata = [
  { term: 'Geography', value: spatialCoverage },
  { term: 'Updated', value: updateFrequency && formatFrequency(updateFrequency) },
  { term: 'Approximate size', value: dataSize },
].filter((item) => item.value);
---

<PageLayout
	title={`${title} — M-Lab Data Catalog`}
	description={description.slice(0, 160)}
>
	<Fragment slot="head">
		<JsonLd data={datasetJsonLd} />
		<meta name="DC.title" content={title} />
		<meta name="DC.description" content={description.slice(0, 500)} />
		<meta name="DC.creator" content="Measurement Lab" />
		<meta name="DC.publisher" content="Measurement Lab" />
		<meta name="DC.language" content="en" />
		<meta name="DC.type" content="Dataset" />
		<meta name="DC.rights" content="CC0 1.0 Universal (Public Domain)" />
		<meta name="DC.license" content={LICENSE_URL} />
		{keywords.map((s) => <meta name="DC.subject" content={s} />)}
		{temporalCoverage && <meta name="DC.coverage" content={temporalCoverage} />}
		{spatialCoverage && <meta name="DC.spatial" content={spatialCoverage} />}
		<meta name="DC.identifier" content={canonicalUrl} />
		<!-- No canonical link here: BaseLayout already emits one from Astro.site. -->
	</Fragment>

	<!-- Breadcrumbs -->
	<SectionLayout padding={false}>
		<nav class="px-4 py-4 sm:px-6 lg:px-8" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-2 text-base">
				<li class="flex items-center gap-2">
					<Link href="/datasets" variant="crumb">Data Catalog</Link>
				</li>
				<li class="flex items-center gap-2">
					<span class="text-neutral-400">/</span>
					<span class="text-neutral-600">{title}</span>
				</li>
			</ol>
		</nav>
	</SectionLayout>

	<!-- Hero -->
	<SectionLayout sectionLabel="hero" maxWidth="4xl" zigzag="supporting1-light">
		<HeroSection title={title}>
			<div class="flex flex-wrap justify-center gap-2">
				<Tag variant="primary" size="md">{categoryName}</Tag>
				{
					coverageLabel && (
						<Tag variant="neutral" size="md">
							{coverageLabel}
						</Tag>
					)
				}
			</div>
		</HeroSection>
	</SectionLayout>

	<SectionLayout>
		<div class="mx-auto max-w-4xl py-12">
			<!-- About -->
			<section class="mb-12">
				<h2 class="mb-6 text-2xl font-bold">About this dataset</h2>
				<p class="text-lg leading-relaxed text-neutral-800">{description}</p>
			</section>

			<!-- Access the data — the page's primary job -->
			{
				accessPoints && accessPoints.length > 0 && (
					<section class="mb-12">
						<h2 class="mb-6 text-2xl font-bold">Access the data</h2>
						<div class="space-y-3">
							{accessPoints.map((ap) => (
								<Card
									variant="elevated"
									padding="md"
									href={accessUrl(ap.url)}
									external={isExternal(ap.url)}
								>
									<div class="flex items-start justify-between gap-4">
										<div class="min-w-0">
											<div class="mb-2">
												<Tag variant={accessVariant(ap.type)} size="sm">
													{ap.format}
												</Tag>
											</div>
											<p class="text-lg font-semibold text-neutral-900">
												{ap.label}
											</p>
											{ap.description && (
												<p class="mt-1 text-base text-neutral-600">
													{ap.description}
												</p>
											)}
											{ap.url.startsWith('gs://') && (
												<code class="mt-2 inline-block font-mono text-base break-all text-neutral-600">
													{ap.url}
												</code>
											)}
										</div>
										<ArrowTopRightOnSquareIcon
											className="mt-1 h-5 w-5 shrink-0 text-neutral-400"
											aria-hidden="true"
										/>
									</div>
								</Card>
							))}
						</div>
					</section>
				)
			}

			<!-- Dataset properties. Always rendered: publisher and licence are constants. -->
			{
				(
					<section class="mb-12">
						<h2 class="mb-6 text-2xl font-bold">Dataset info</h2>
						<Card variant="default">
							<dl class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
								{metadata.map((item) => (
									<div>
										<dt class="mb-1 text-base text-neutral-500">{item.term}</dt>
										<dd class="text-lg font-medium text-neutral-900">
											{item.value}
										</dd>
									</div>
								))}
								<div>
									<dt class="mb-1 text-base text-neutral-500">Publisher</dt>
									<dd class="text-lg font-medium">
										<a href={MLAB_CREATOR.url}>Measurement Lab</a>
									</dd>
								</div>
								<div>
									<dt class="mb-1 text-base text-neutral-500">License</dt>
									<dd class="text-lg font-medium">
										<a
											href={LICENSE_URL}
											target="_blank"
											rel="noopener noreferrer"
										>
											CC0 1.0 Universal
										</a>
									</dd>
								</div>
								{testRef && (
									<div>
										<dt class="mb-1 text-base text-neutral-500">Source test</dt>
										<dd class="text-lg font-medium">
											<a href={`/tests/${testRef}/`}>{testRef}</a>
										</dd>
									</div>
								)}
							</dl>
						</Card>
					</section>
				)
			}

			<!-- Documentation -->
			{
				(documentationLinks ?? []).length > 0 && (
					<section class="mb-12">
						<h2 class="mb-6 text-2xl font-bold">Documentation</h2>
						<ul class="space-y-3">
							{documentationLinks!.map((link) => (
								<li class="flex items-center gap-3">
									<DocumentTextIcon
										className="h-5 w-5 shrink-0 text-neutral-400"
										aria-hidden="true"
									/>
									<a
										href={link.url}
										target={link.url.startsWith('http') ? '_blank' : undefined}
										rel={
											link.url.startsWith('http')
												? 'noopener noreferrer'
												: undefined
										}
										class="text-lg"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<!-- Related datasets -->
			{
				related.length > 0 && (
					<section>
						<h2 class="mb-6 text-2xl font-bold">Related datasets</h2>
						<ul class="space-y-3">
							{related.map((rel) =>
								rel ? (
									<li class="flex items-center gap-3">
										<ChevronRightIcon
											className="h-5 w-5 shrink-0 text-neutral-400"
											aria-hidden="true"
										/>
										<a href={`/datasets/${rel.id}`} class="text-lg">
											{rel.data.title}
										</a>
									</li>
								) : null
							)}
						</ul>
					</section>
				)
			}
		</div>
	</SectionLayout>
</PageLayout>
