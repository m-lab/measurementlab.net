---
import { getEntry } from 'astro:content';
// Import landing page components
import Banner from '@components/atoms/Banner.astro';
import BlogLanding from '@components/landing/BlogLanding.astro';
import DatasetsCatalogJsonLd from '@components/landing/DatasetsCatalogJsonLd.astro';
import DatasetsLanding from '@components/landing/DatasetsLanding.astro';
import KnowledgeBaseLanding from '@components/landing/KnowledgeBaseLanding.astro';
import PeopleLanding from '@components/landing/PeopleLanding.astro';
import PublicationsLanding from '@components/landing/PublicationsLanding.astro';
import TestsLanding from '@components/landing/TestsLanding.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import Sections from '@components/sections/Sections.astro';
import PageLayout from '@layouts/PageLayout.astro';
import SectionLayout from '@layouts/SectionLayout.astro';
import { getPages } from '@utils/pages';

import type { GetStaticPaths } from 'astro';

// Generate static paths from pages collection
// In production, only published pages are built
export const getStaticPaths = (async () => {
  const pages = await getPages();
  return pages.map((page) => ({
    params: { path: page.data.permalink },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Detect special landing pages
const landingComponents = {
	blog: BlogLanding,
	publications: PublicationsLanding,
	people: PeopleLanding,
	// tests: TestsLanding,
	datasets: DatasetsLanding,
	kb: KnowledgeBaseLanding
} as const;

const LandingComponent =
	landingComponents[page.id as keyof typeof landingComponents];

// Optional <head> content for a landing page.
// Keyed the same way as landingComponents so page-specific markup stays in its own
// component rather than being special-cased here.
const landingHeadComponents = {
	datasets: DatasetsCatalogJsonLd,
} as const;

const LandingHead =
	landingHeadComponents[page.id as keyof typeof landingHeadComponents];

// Filter hero to avoid duplication (hero rendered separately)
const sections = page.data.sections

const zigzag = (!page.data.heroImage && !page.data.zigzag) ? 'primary-light' : page.data.zigzag

const siteConfig = await getEntry('site', 'config');
const archivedBanner = siteConfig?.data.archivedBanner;

---

<PageLayout title={page.data.title} description={page.data.description}>
  {
    LandingHead && (
      <Fragment slot="head">
        <LandingHead />
      </Fragment>
    )
  }
  <SectionLayout
    maxWidth="2xl"
    bgImage={page.data.heroImage}
    sectionLabel="hero"
    zigzag={zigzag}
  >
    <HeroSection title={page.data.title} subtitle={page.data.description} />
  </SectionLayout>
  {
    page.data.status === 'archived' && archivedBanner && (
      <Banner message={archivedBanner.message} color={archivedBanner.color} />
    )
  }
  <!-- Main Page Content (Sections) -->
  {sections && <Sections sectionItems={sections} />}

  <!-- Custom landing page content (only for blog, publications, people)  -->
  {LandingComponent && <LandingComponent />}
</PageLayout>

<script>
  const toc = document.querySelector('aside#toc');
  if (toc) {
    console.log('TOC aside is present');
  }
</script>
