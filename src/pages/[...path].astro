---
import { getCollection } from 'astro:content';
// Import landing page components
import BlogLanding from '@components/landing/BlogLanding.astro';
import PeopleLanding from '@components/landing/PeopleLanding.astro';
import PublicationsLanding from '@components/landing/PublicationsLanding.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import Sections from '@components/sections/Sections.astro';
import PageLayout from '@layouts/PageLayout.astro';
import SectionLayout from '@layouts/SectionLayout.astro';

import type { GetStaticPaths } from 'astro';

// Generate static paths from pages collection
export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { path: page.id },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Detect special landing pages
const landingComponents = {
	blog: BlogLanding,
	publications: PublicationsLanding,
	people: PeopleLanding,
} as const;

const LandingComponent =
	landingComponents[page.id as keyof typeof landingComponents];

// Filter hero to avoid duplication (hero rendered separately)
const sections = page.data.sections


---

<PageLayout title={page.data.title} description={page.data.description}>
	<SectionLayout
		maxWidth="2xl"
		bgImage={page.data.heroImage}
		sectionLabel="hero"
		zigzag={page.data.zigzag}
	>
		<HeroSection title={page.data.title} subtitle={page.data.description} />
	</SectionLayout>

	<!-- Custom landing page content (only for blog, publications, people)  -->
	{
		LandingComponent && (
			<LandingComponent />
		)
	}
	<!-- Main Page Content (Sections) -->
	{sections && <Sections sectionItems={sections} />}
</PageLayout>
