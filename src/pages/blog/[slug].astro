---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import Banner from '@components/atoms/Banner.astro';
import Link from '@components/atoms/Link'
import Tag from '@components/atoms/Tag';
import Hero from '@components/organisms/Hero.astro';
import PageLayout from '@layouts/PageLayout.astro';
import SectionLayout from '@layouts/SectionLayout.astro';
import {
  formatBlogDate,
  getRelatedPosts,
} from '@utils/blog';
import { isVisible } from '@utils/content';
import { isDev } from '@utils/dev';
import {
  getAllAuthorNames,
  getPeopleMap,
  resolvePeople
} from '@utils/people';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts
    .filter((post) => isVisible(post))
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Get author details and related posts using utilities
const peopleMap = await getPeopleMap();
const authors = await resolvePeople(post.data.authors, peopleMap);
const allAuthorNames = await getAllAuthorNames(
  post.data.authors,
  post.data.externalAuthors,
  peopleMap
);
const relatedPosts = await getRelatedPosts(post, { peopleMap });

// Helper for template
const formatDate = formatBlogDate;

const {title, publishedDate, heroImage, categories, status } = post.data

const siteConfig = await getEntry('site', 'config');
const archivedBanner = siteConfig?.data.archivedBanner;

---

<PageLayout
	title={post.data.title}
	description={`Blog post by ${allAuthorNames}`}
	image={heroImage}
>
	<!-- Post Header -->
	<SectionLayout
		maxWidth="4xl"
		bgImage={heroImage}
		zigzag="primary-light"
		sectionLabel="hero"
	>
		<Hero title={title} align="left">
			{/* Draft badge (only visible in dev) */}
			{
				isDev && status === 'draft' && (
					<div class="mb-4">
						<Tag variant="neutral" size="md" className="font-bold">
							DRAFT
						</Tag>
					</div>
				)
			}
			{/* Categories */}
			<div class="mb-4 flex flex-wrap gap-2">
				{
					categories.map((category) => (
						<Tag variant="primary" size="md">
							{category}
						</Tag>
					))
				}
			</div>

			{/* Metadata */}
			<div class="flex flex-wrap items-center gap-4 text-neutral-500">
				<p class="text-base">
					By
					{
						authors.map((a, i) => (
							<>
								<Link
									variant="unstyled"
									className="inline-flex transition hover:text-neutral-800"
									href={`/people/${a?.id}`}
								>
									{a?.name}
								</Link>
								{(i < authors.length - 1 || post.data.externalAuthors) && ' • '}
							</>
						))
					}
					{
						post.data.externalAuthors && (
							<span>{post.data.externalAuthors}</span>
						)
					}
				</p>
				<span class="">•</span>
				<p class="text-base">
					{formatDate(publishedDate)}
				</p>
			</div>
		</Hero>
	</SectionLayout>
	{
		status === 'archived' && archivedBanner && (
			<Banner message={archivedBanner.message} color={archivedBanner.color} />
		)
	}

	<!-- Post Content -->
	<SectionLayout>
		<article class="mx-auto prose prose-a:text-primary-600">
			<Content />
		</article>
	</SectionLayout>

	<!-- Related Posts Section -->
	{
		relatedPosts.length > 0 && (
			<SectionLayout bgColor="gray">
				<div class="mx-auto max-w-4xl py-12">
					<h2 class="mb-8 text-2xl font-bold">Related Posts</h2>
					<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
						{relatedPosts.map((relatedPost) => (
							<Link
								variant="unstyled"
								href={`/blog/${relatedPost.id}`}
								clasName="flex flex-col overflow-hidden rounded-lg bg-white no-underline transition hover:shadow-lg"
							>
								{/* Hero Image */}
								{relatedPost.data.heroImage && (
									<Image
										src={relatedPost.data.heroImage}
										alt={relatedPost.data.title}
										class="h-48 w-full object-cover"
										width={800}
										height={384}
									/>
								)}

								{/* Card Content */}
								<div class="flex flex-col gap-3 p-6">
									{/* Categories */}
									<div class="flex flex-wrap gap-2">
										{relatedPost.data.categories.slice(0, 2).map((category) => (
											<Tag variant="primary" size="sm">
												{category}
											</Tag>
										))}
									</div>

									{/* Title */}
									<h3 class="line-clamp-2 text-lg font-semibold">
										{relatedPost.data.title}
									</h3>

									{/* Metadata: Authors and Date */}
									<div class="text-gray-600 mt-auto text-sm">
										{/* Joined in one expression: the Rust compiler (Astro 7) preserves
										    the whitespace between adjacent JSX expressions, which the old Go
										    compiler stripped — splitting this across lines renders "Name , Name". */}
										<p>
											By{' '}
											{[
												...relatedPost.resolvedAuthors.map((a) => a?.name),
												relatedPost.data.externalAuthors,
											]
												.filter(Boolean)
												.join(', ')}
										</p>
										<p class="text-gray-500 mt-1 text-xs">
											{formatDate(relatedPost.data.publishedDate)}
										</p>
									</div>
								</div>
							</Link>
						))}
					</div>
				</div>
			</SectionLayout>
		)
	}

	<!-- Authors Section -->
	{
		authors && (
			<SectionLayout bgColor="bg-gray-50">
				<div class="mx-auto max-w-4xl py-12">
					<h2 class="mb-8 text-2xl font-bold">
						{authors.length === 1 ? 'About the Author' : 'About the Authors'}
					</h2>
					<div class="grid gap-6 md:grid-cols-2">
						{authors.map(
							(author) =>
								author && (
									<Link
										variant="unstyled"
										href={`/people/${author.id}`}
										className="flex gap-4 rounded-lg bg-white p-6 no-underline transition hover:shadow-sm"
									>
										{author.headshot && (
											<Image
												src={author.headshot}
												alt={author.name}
												class="h-16 w-16 rounded-full object-cover"
												width={128}
												height={128}
											/>
										)}

										<div>
											<h3 class="mb-1 text-lg font-semibold">{author.name}</h3>
											<p class="text-gray-600 text-sm">{author.title}</p>
										</div>
									</Link>
								)
						)}
					</div>
				</div>
			</SectionLayout>
		)
	}
</PageLayout>
