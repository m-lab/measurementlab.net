---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Button from '@components/atoms/Button.tsx';
import Link from '@components/atoms/Link';
import Tag from '@components/atoms/Tag';
import HeroSection from '@components/sections/HeroSection.astro';
import PageLayout from '@layouts/PageLayout.astro';
import SectionLayout from '@layouts/SectionLayout.astro';
import {Vimeo, YouTube } from 'astro-embed'
import { marked } from 'marked';
import IconPlay from '~icons/heroicons/play-circle'

export async function getStaticPaths() {
  const publications = await getCollection('publications');

  return publications.map((pub) => ({
    params: { slug: pub.id },
    props: { pub },
  }));
}

const { pub } = Astro.props;

// Fetch all people for contributor lookups
const allPeople = await getCollection('people');
const peopleMap = new Map(allPeople.map((person) => [person.data.id, person.data]));

// Get contributor details
const contributors = pub.data.contributors
  ? pub.data.contributors
      .map((id) => peopleMap.get(id))
      .filter(Boolean)
  : [];

// Get related publications (same category or year)
const allPublications = await getCollection('publications');

const relatedPublications = allPublications
  .filter(p =>
    p.id !== pub.id && // Not the current publication
    (p.data.category === pub.data.category || p.data.year === pub.data.year) // Same category or year
  )
  .sort((a, b) => {
    // Prioritize same category
    const aSameCategory = a.data.category === pub.data.category ? 1 : 0;
    const bSameCategory = b.data.category === pub.data.category ? 1 : 0;
    if (bSameCategory !== aSameCategory) {
      return bSameCategory - aSameCategory;
    }
    // Then sort by year (newest first)
    return b.data.year - a.data.year;
  })
  .slice(0, 3);

// Helper to format category for display
const formatCategory = (category: string) => {
  return category
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};

// Parse markdown in description
const descriptionHtml = pub.data.description ? marked.parse(pub.data.description) : '';

const { title, year, category, authors, venue, tags } = pub.data;
---

<PageLayout
	title={title}
	description={`${formatCategory(category)} from ${year}${authors ? ` by ${authors}` : ''}`}
>
	<!-- Publication Header -->
	<SectionLayout sectionLabel="hero" zigzag="supporting1-light" maxWidth="4xl">
		<HeroSection title={title}>
			{/* Category, Year, and Tags */}
			<div class="mb-4 flex flex-wrap gap-2">
				<Tag variant="primary" size="md">
					{formatCategory(category)}
				</Tag>
				<Tag variant="secondary" size="md">
					{year}
				</Tag>
				{
					tags &&
						tags.map((tag) => (
							<Tag variant="primary" size="md">
								{tag}
							</Tag>
						))
				}
			</div>

			{/* Authors/Citation */}
			{
				authors && (
					<div class="mb-3">
						<p class="text-gray-700 text-base">
							<span class="font-medium">Authors:</span> {authors}
						</p>
					</div>
				)
			}

			{/* Venue */}
			{
				venue && (
					<div class="mb-3">
						<p class="text-gray-700 text-base">
							<span class="font-medium">Venue:</span> {venue}
						</p>
					</div>
				)
			}
		</HeroSection>
	</SectionLayout>

	<!-- Publication Content -->
	<SectionLayout>
		<div class="mx-auto max-w-4xl py-12">
			{/* Description */}
			{
				pub.data.description && (
					<div class="prose mb-8 max-w-none prose-blue">
						<Fragment set:html={descriptionHtml} />
					</div>
				)
			}

			{/* Resources Section */}
			{
				(pub.data.internalLinks?.length ||
					pub.data.externalLinks?.length ||
					pub.data.videoLinks?.length) && (
					<div class="mb-12">
						<h2 class="mb-6 text-2xl font-bold">Resources</h2>
						<div class="space-y-6">
							{/* Internal Links (PDFs, etc.) */}
							{pub.data.internalLinks && pub.data.internalLinks.length > 0 && (
								<div>
									<h3 class="mb-3 text-lg font-semibold">Downloads</h3>
									<div class="space-y-2">
										{pub.data.internalLinks.map((link) => (
											<div class="border-gray-200 bg-gray-50 flex items-center gap-3 rounded-lg border p-4">
												<svg
													class="text-blue-600 h-6 w-6 shrink-0"
													fill="none"
													stroke="currentColor"
													viewBox="0 0 24 24"
												>
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
													/>
												</svg>
												<div class="flex-1">
													<Link
														variant="default"
														href={`/${link.path}`}
														target="_blank"
													>
														{link.label}
													</Link>
												</div>
											</div>
										))}
									</div>
								</div>
							)}

							{/* External Links */}
							{pub.data.externalLinks && pub.data.externalLinks.length > 0 && (
								<div>
									<h3 class="mb-3 text-lg font-semibold">External Resources</h3>
									<div class="space-y-2">
										{pub.data.externalLinks.map((link) => (
											<div class="border-gray-200 bg-gray-50 flex items-center gap-3 rounded-lg border p-4">
												<svg
													class="text-blue-600 h-6 w-6 shrink-0"
													fill="none"
													stroke="currentColor"
													viewBox="0 0 24 24"
												>
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
													/>
												</svg>
												<div class="flex-1">
													<Link
														variant="default"
														href={link.url}
														target="_blank"
													>
														{link.label}
													</Link>
												</div>
											</div>
										))}
									</div>
								</div>
							)}

							{/* Video Links */}
							{pub.data.videoLinks && pub.data.videoLinks.length > 0 && (
								<div>
									<h3 class="mb-3 text-lg font-semibold">Videos</h3>
									<div class="space-y-2">
										{pub.data.videoLinks.map((link) => {
											const content = (() => {
												switch (link.platform) {
													case 'youtube':
														return <YouTube id={link.url} />;
													case 'vimeo':
														return <Vimeo id={link.url} />;
													default:
														return (
															<div class="border-gray-200 bg-gray-50 flex items-center gap-3 rounded-lg border p-4">
																<IconPlay />
																<div class="flex-1">
																	<Link
																		variant="default"
																		href={link.url}
																		target="_blank"
																	>
																		{link.label}
																	</Link>
																	{link.platform && (
																		<span class="text-gray-500 ml-2 text-sm">
																			({link.platform})
																		</span>
																	)}
																</div>
															</div>
														);
												}
											})();

											return content;
										})}
									</div>
								</div>
							)}
						</div>
					</div>
				)
			}
		</div>
	</SectionLayout>

	<!-- Contributors Section -->
	{
		contributors.length > 0 && (
			<SectionLayout bgColor="bg-gray-50">
				<div class="mx-auto max-w-4xl py-12">
					<h2 class="mb-8 text-2xl font-bold">
						{contributors.length === 1 ? 'Contributor' : 'Contributors'}
					</h2>
					<div class="grid gap-6 md:grid-cols-2">
						{contributors.map(
							(contributor) =>
								contributor && (
									<Link
										variant="unstyled"
										href={`/people/${contributor.id}`}
										className="flex gap-4 rounded-lg bg-white p-6 no-underline transition hover:shadow-sm"
									>
										{contributor.headshot && (
											<Image
												src={contributor.headshot}
												alt={contributor.name}
												class="h-16 w-16 rounded-full object-cover"
											/>
										)}

										<div>
											<h3 class="mb-1 text-lg font-semibold">
												{contributor.name}
											</h3>
											<p class="text-gray-600 text-sm">{contributor.title}</p>
										</div>
									</Link>
								)
						)}
					</div>
				</div>
			</SectionLayout>
		)
	}

	<!-- Related Publications Section -->
	{
		relatedPublications.length > 0 && (
			<SectionLayout bgColor="gray">
				<div class="mx-auto max-w-4xl py-12">
					<h2 class="mb-8 text-2xl font-bold">Related Publications</h2>
					<div class="space-y-4">
						{relatedPublications.map((relatedPub) => (
							<Link
								variant="unstyled"
								href={`/publications/${relatedPub.id}`}
								classHame="block rounded-lg bg-white p-6 no-underline transition hover:shadow-lg"
							>
								{/* Title and Tags */}
								<div class="mb-3 flex flex-wrap items-start justify-between gap-2">
									<h3 class="flex-1 text-lg font-semibold">
										{relatedPub.data.title}
									</h3>
									<div class="flex flex-wrap gap-2">
										<Tag variant="primary" size="sm">
											{formatCategory(relatedPub.data.category)}
										</Tag>
										<Tag variant="secondary" size="sm">
											{relatedPub.data.year}
										</Tag>
									</div>
								</div>

								{/* Authors */}
								{relatedPub.data.authors && (
									<p class="text-gray-600 text-sm">{relatedPub.data.authors}</p>
								)}

								{/* Description (truncated) */}
								{relatedPub.data.description && (
									<p class="text-gray-700 mt-2 line-clamp-2 text-sm">
										{relatedPub.data.description}
									</p>
								)}
							</Link>
						))}
					</div>
				</div>
			</SectionLayout>
		)
	}
</PageLayout>
