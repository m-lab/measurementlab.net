---
import {
  type CollectionEntry,
  getCollection,
  getEntry,
  render,
} from 'astro:content';
import Banner from '@components/atoms/Banner.astro';
import Link from '@components/atoms/Link';
import Hero from '@components/organisms/Hero.astro';
import PageLayout from '@layouts/PageLayout.astro';
import SectionLayout from '@layouts/SectionLayout.astro';
import { isVisible } from '@utils/content';

type TestEntry = CollectionEntry<'tests'>;

export async function getStaticPaths() {
  const tests = await getCollection('tests');

  return tests.filter((test) => isVisible(test)).map((test) => {
    // Convert permalink to slug: /tests/ndt/ -> ndt, /tests/ndt/ndt5/ -> ndt/ndt5
    const slug = test.data.permalink
      .replace(/^\/tests\//, '')
      .replace(/\/$/, '');

    return {
      params: { slug: slug || undefined },
      props: { test },
    };
  });
}

const { test } = Astro.props;
const { Content } = await render(test);

// Get all tests for navigation
const allTests = await getCollection('tests');

// Find parent test if this is a nested test
let parentTest: TestEntry | undefined;
if (test.data.parentTest) {
  parentTest = allTests.find((t) => t.data.permalink === test.data.parentTest);
}

// Find child tests if this is a parent
const childTests = allTests
  .filter((t) => t.data.parentTest === test.data.permalink)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

// Build breadcrumbs
interface Breadcrumb {
  label: string;
  href: string;
}
const breadcrumbs: Breadcrumb[] = [{ label: 'Tests', href: '/tests/' }];

if (parentTest) {
  breadcrumbs.push({
    label: parentTest.data.title,
    href: parentTest.data.permalink,
  });
}

breadcrumbs.push({
  label: test.data.title,
  href: test.data.permalink,
});

// Test status badge styling
const testStatusStyles = {
  current: 'bg-neutral-600 text-white',
  'core-service': 'bg-blue-100 text-blue-800',
  retired: 'bg-neutral-100 text-neutral-800',
  'retired-core-service': 'bg-neutral-100 text-neutral-800',
};

const testStatusLabels = {
  current: 'Current',
  'core-service': 'Core Service',
  retired: 'Retired',
  'retired-core-service': 'Retired Core Service',
};

const siteConfig = await getEntry('site', 'config');
const archivedBanner = siteConfig?.data.archivedBanner;
---

<PageLayout title={test.data.title} description={test.data.description}>
	<!-- Breadcrumbs -->
	<SectionLayout padding={false}>
		<nav class="px-4 py-4 sm:px-6 lg:px-8" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-2 text-sm">
				{
					breadcrumbs.map((crumb, index) => (
						<li class="flex items-center gap-2">
							{index > 0 && <span class="text-neutral-400">/</span>}
							{index === breadcrumbs.length - 1 ? (
								<span class="text-neutral-600">{crumb.label}</span>
							) : (
								<Link href={crumb.href} variant="crumb">
									{crumb.label}
								</Link>
							)}
						</li>
					))
				}
			</ol>
		</nav>
	</SectionLayout>

	<!-- Hero Section -->
	<SectionLayout maxWidth="4xl" zigzag="supporting1-light">
		<Hero title={test.data.title} align="left">
			{
				test.data.testStatus && (
					<span
						class={`inline-block rounded-md px-3 py-1 text-sm font-medium uppercase ${testStatusStyles[test.data.testStatus]}`}
					>
						{testStatusLabels[test.data.testStatus]}
					</span>
				)
			}
			{
				test.data.description && (
					<p class="text-neutral-600 mt-4">{test.data.description}</p>
				)
			}
		</Hero>
	</SectionLayout>
	{test.data.status === 'archived' && archivedBanner && <Banner message={archivedBanner.message} color={archivedBanner.color} />}

	<!-- Sub-navigation for nested tests -->
	{
		childTests.length > 0 && (
			<SectionLayout bgColor="gray">
				<h3 class="font-semibold">Related tests:</h3>
				<nav class="pt-2">
					<div class="flex flex-wrap gap-2">
						{childTests.map((child) => (
							<Link href={child.data.permalink} variant="unstyled" class="">
								<span class="rounded-md bg-white px-3 py-1 text-sm text-primary-600 shadow-sm hover:bg-primary-50">
									{child.data.title}
								</span>
							</Link>
						))}
					</div>
				</nav>
			</SectionLayout>
		)
	}

	<!-- Main Content -->
	<SectionLayout>
		<article class="mx-auto prose prose-a:text-primary-600">
			<Content />
		</article>
	</SectionLayout>

	<!-- Back navigation -->
	<SectionLayout>
		<div class="border-neutral-200 border-t pt-8">
			<div class="flex flex-wrap gap-4">
				{
					parentTest ? (
						<Link
							href={parentTest.data.permalink}
							variant="unstyled"
							class="text-primary-600 hover:underline"
						>
							&larr; Back to {parentTest.data.title}
						</Link>
					) : (
						<Link
							href="/tests/"
							variant="unstyled"
							class="text-primary-600 hover:underline"
						>
							&larr; Back to All Tests
						</Link>
					)
				}
			</div>
		</div>
	</SectionLayout>
</PageLayout>
