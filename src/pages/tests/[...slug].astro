---
import { type CollectionEntry, getCollection } from 'astro:content';
import Link from '@components/atoms/Link';
import Hero from '@components/organisms/Hero.astro';
import PageLayout from '@layouts/PageLayout.astro';
import SectionLayout from '@layouts/SectionLayout.astro';

type TestEntry = CollectionEntry<'tests'>;

export async function getStaticPaths() {
  const tests = await getCollection('tests');

  return tests.map((test) => {
    // Convert permalink to slug: /tests/ndt/ -> ndt, /tests/ndt/ndt5/ -> ndt/ndt5
    const slug = test.data.permalink
      .replace(/^\/tests\//, '')
      .replace(/\/$/, '');

    return {
      params: { slug: slug || undefined },
      props: { test },
    };
  });
}

const { test } = Astro.props;
const { Content } = await test.render();

// Get all tests for navigation
const allTests = await getCollection('tests');

// Find parent test if this is a nested test
let parentTest: TestEntry | undefined;
if (test.data.parentTest) {
  parentTest = allTests.find((t) => t.data.permalink === test.data.parentTest);
}

// Find child tests if this is a parent
const childTests = allTests
  .filter((t) => t.data.parentTest === test.data.permalink)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

// Build breadcrumbs
interface Breadcrumb {
  label: string;
  href: string;
}
const breadcrumbs: Breadcrumb[] = [{ label: 'Tests', href: '/tests/' }];

if (parentTest) {
  breadcrumbs.push({
    label: parentTest.data.title,
    href: parentTest.data.permalink,
  });
}

breadcrumbs.push({
  label: test.data.title,
  href: test.data.permalink,
});

// Status badge styling
const statusStyles = {
  current: 'bg-green-100 text-green-800',
  'core-service': 'bg-blue-100 text-blue-800',
  retired: 'bg-gray-100 text-gray-800',
  'retired-core-service': 'bg-gray-100 text-gray-800',
};

const statusLabels = {
  current: 'Current',
  'core-service': 'Core Service',
  retired: 'Retired',
  'retired-core-service': 'Retired Core Service',
};
---

<PageLayout title={test.data.title} description={test.data.description}>
	<!-- Breadcrumbs -->
	<SectionLayout padding={false}>
		<nav class="px-4 py-4 sm:px-6 lg:px-8" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-2 text-sm">
				{
					breadcrumbs.map((crumb, index) => (
						<li class="flex items-center gap-2">
							{index > 0 && <span class="text-gray-400">/</span>}
							{index === breadcrumbs.length - 1 ? (
								<span class="text-gray-600">{crumb.label}</span>
							) : (
								<Link
									href={crumb.href}
									variant="unstyled"
									class="text-primary-600 hover:underline"
								>
									{crumb.label}
								</Link>
							)}
						</li>
					))
				}
			</ol>
		</nav>
	</SectionLayout>

	<!-- Hero Section -->
	<SectionLayout>
		<Hero background="transparent" title={test.data.title} align="left">
			{
				test.data.status && (
					<span
						class={`inline-block rounded-full px-3 py-1 text-sm font-medium ${statusStyles[test.data.status]}`}
					>
						{statusLabels[test.data.status]}
					</span>
				)
			}
			{
				test.data.description && (
					<p class="text-gray-600 mt-4 text-lg">{test.data.description}</p>
				)
			}
		</Hero>
	</SectionLayout>

	<!-- Sub-navigation for nested tests -->
	{
		childTests.length > 0 && (
			<SectionLayout bgColor="gray" padding={false}>
				<nav class="px-4 py-4 sm:px-6 lg:px-8">
					<div class="flex flex-wrap gap-2">
						<span class="text-gray-700 text-sm font-medium">Related:</span>
						{childTests.map((child) => (
							<Link
								href={child.data.permalink}
								variant="unstyled"
								class="rounded-md bg-white px-3 py-1 text-sm text-primary-600 shadow-sm hover:bg-primary-50"
							>
								{child.data.title}
							</Link>
						))}
					</div>
				</nav>
			</SectionLayout>
		)
	}

	<!-- Main Content -->
	<SectionLayout>
		<article
			class="mx-auto prose max-w-none prose-headings:scroll-mt-20 prose-a:text-primary-600"
		>
			<Content />
		</article>
	</SectionLayout>

	<!-- Back navigation -->
	<SectionLayout>
		<div class="border-gray-200 border-t pt-8">
			<div class="flex flex-wrap gap-4">
				{
					parentTest ? (
						<Link
							href={parentTest.data.permalink}
							variant="unstyled"
							class="text-primary-600 hover:underline"
						>
							&larr; Back to {parentTest.data.title}
						</Link>
					) : (
						<Link
							href="/tests/"
							variant="unstyled"
							class="text-primary-600 hover:underline"
						>
							&larr; Back to All Tests
						</Link>
					)
				}
			</div>
		</div>
	</SectionLayout>
</PageLayout>
