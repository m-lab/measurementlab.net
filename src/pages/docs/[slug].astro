---
import { getCollection, render } from 'astro:content';
import DocsLayout from '@layouts/DocsLayout.astro';
import type { TocEntry } from '@stefanprobst/rehype-extract-toc';
import { isVisible } from '@utils/content';
import { getDocChapters, getDocNavigation } from '@utils/docs';

export async function getStaticPaths() {
  const docs = await getCollection('docs');

  return docs
    .filter((doc) => isVisible(doc))
    .map((doc) => ({
      params: { slug: doc.data.permalink },
      props: { doc },
    }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

// A flat h2/h3 list, not the nested tree @utils/renderMarkdown produces: the TOC
// component indents by `depth` and only recurses into `children` above depth 2,
// so a flat list renders identically and skips the tree build.
const toc: TocEntry[] = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ id: h.slug, value: h.text, depth: h.depth }));

const chapters = await getDocChapters();
const { prev, next } = await getDocNavigation(doc.data.permalink);
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  chapter={doc.data.chapter}
  difficulty={doc.data.difficulty}
  status={doc.data.status}
  chapters={chapters}
  currentPermalink={doc.data.permalink}
  toc={toc}
  prev={prev}
  next={next}
>
  <Content />
</DocsLayout>
