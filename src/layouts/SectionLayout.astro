---
import { Image } from 'astro:assets';
import DevOnly from '@components/atoms/DevOnly.astro';
import ZigZagPattern from '@components/atoms/ZigZagPattern.astro'
import { backgroundClass, textClass as textClasses } from '@utils/backgrounds';
import { devClass } from '@utils/dev';
import type { ImageMetadata } from 'astro';

export interface Props {
  containerized?: boolean;
  maxWidth?: 'full' | '7xl' | '6xl' | '5xl' | '4xl' | '2xl';
  padding?: boolean;
  class?: string;
	bgColor?: string;
	/**
	 * Background of an enclosing section (e.g. a flexi wrapper). Used only to decide
	 * text contrast when this section paints no background of its own — nested content
	 * sits on the parent's surface, so it must invert with the parent.
	 */
	inheritedBgColor?: string;
	bgImage?: ImageMetadata;
	sectionLabel?: string;
	zigzag?: string
	zigzagSize?: { left: number; right: number };
}

const {
  containerized = true,
  maxWidth = '7xl',
  padding = true,
  class: className = '',
	bgColor,
	inheritedBgColor,
  bgImage,
	sectionLabel = 'section',
	zigzag,
	zigzagSize,
} = Astro.props;


const maxWidths = {
  full: 'max-w-full',
  '7xl': 'max-w-7xl',
  '6xl': 'max-w-6xl',
  '5xl': 'max-w-5xl',
  '4xl': 'max-w-4xl',
	'2xl': 'max-w-2xl'
};

const containerClass = containerized ? `mx-auto ${maxWidths[maxWidth]}` : '';
const paddingClass = padding ? 'px-4 sm:px-6 lg:px-8 py-8' : '';

// Background and text classes both come from @utils/backgrounds so a new background
// colour never has to be registered in more than one place.
//
// Only this section's own colour paints — inheriting would repaint the parent's surface
// underneath itself. But contrast follows whichever surface the content actually sits
// on, which is the parent's when this section paints nothing.
const bgClass = backgroundClass(bgColor ?? 'white');
const textClass = textClasses(bgColor ?? inheritedBgColor ?? 'white');
// const sectionBgClass = bgType === 'full' ? bgClass : '';
// const containerBgClass = bgType === 'contained' ? bgClass : '';

---

<section
	class={`relative ${bgClass} ${devClass('border-t border-b border-gray-300 border-dotted')}`}
>
	<DevOnly>
		<span
			class="absolute top-0 left-0 z-100 bg-primary-300 p-1 text-sm text-primary-600 uppercase"
			>{sectionLabel}</span
		>
	</DevOnly>
	{zigzag && !bgImage && <ZigZagPattern style={zigzag} size={zigzagSize} />}

	{
		bgImage && (
			<Image
				src={bgImage}
				alt=""
				class="absolute inset-0 -z-10 h-full w-full object-cover"
				loading="eager"
			/>
		)
	}
	<div
		class={`section-container relative ${containerClass} ${paddingClass} ${textClass} ${className}`}
	>
		<slot />
	</div>
</section>
