---
import '@styles/global.css';
import Head, { type ArticleMeta } from '@components/organisms/Head.astro';
import type { JsonLd } from '@utils/jsonld';

export interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  lang?: string;
  class?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Keep the page out of search indexes (preview builds are always noindex). */
  noindex?: boolean;
  /** Page-specific schema.org nodes, merged into the site graph. */
  jsonLd?: JsonLd | JsonLd[];
  /** Open Graph `article:*` meta for blog posts. */
  article?: ArticleMeta;
}

const {
  title,
  description,
  image,
  lang = 'en',
  class: className = '',
  ogType,
  noindex,
  jsonLd,
  article,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
---

<!doctype html>
<html lang={lang}>
	<head>
		<script is:inline>
			(function() {
				var ua = navigator.userAgent;
				var cls = document.documentElement.classList;
				if (/Mac/.test(ua)) cls.add('os-macos');
				else if (/Win/.test(ua)) cls.add('os-windows');
				else if (/Android/.test(ua)) cls.add('os-android');
				else if (/iPhone|iPad|iPod/.test(ua)) cls.add('os-ios');
				else if (/Linux/.test(ua)) cls.add('os-linux');
			})();
		</script>
		<Head
			title={title}
			description={description}
			canonicalURL={canonicalURL}
			image={image}
			lang={lang}
			ogType={ogType}
			noindex={noindex}
			jsonLd={jsonLd}
			article={article}
		>
			<slot name="head" />
		</Head>
	</head>

	<body class={`bg-neutral-50 ${className}`}>
		<slot />
	</body>
</html>
